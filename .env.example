# Copy to .env and edit. Never commit .env.

# ---- Option A: OpenAI ----
OPENAI_API_KEY=sk-replace-me
OPENAI_BASE=https://api.openai.com/v1
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536
CHAT_MODEL=gpt-4o-mini

# ---- Option B: fully local, no key, no egress ----
# Start Ollama with:  docker compose --profile local-llm up -d
#   docker compose exec ollama ollama pull nomic-embed-text
#   docker compose exec ollama ollama pull qwen2.5:3b-instruct
# EMBED_DIM changes, so re-seed Milvus after switching.
# OPENAI_API_KEY=ollama
# OPENAI_BASE=http://ollama:11434/v1
# EMBED_MODEL=nomic-embed-text
# EMBED_DIM=768
# CHAT_MODEL=qwen2.5:3b-instruct

# ---- Option C: a self-hosted llm-launchpad box ----
# One GPU box serving both models over the OpenAI wire format. No key, no egress.
# Set it with:  ./run.sh use-launchpad http://<box>:5001/v1 [API_TOKEN]
# which reads the served model and its width from the box, so EMBED_DIM cannot drift.
# The URL must be reachable from inside the containers — not localhost, which inside a
# container is the container. EMBED_DIM changes, so re-seed Milvus after switching.
# OPENAI_API_KEY=not-needed
# OPENAI_BASE=http://<box>:5001/v1
# EMBED_MODEL=BAAI/bge-base-en-v1.5
# EMBED_DIM=768
# CHAT_MODEL=local
#
# Switch back to OpenAI at any time with:  ./run.sh use-openai

# ---- infrastructure ----
MILVUS_ENDPOINT=milvus-standalone
MILVUS_URI=http://milvus-standalone:19530
MILVUS_COLLECTION=maintenance_manual
KAFKA_BOOTSTRAP=kafka:9092
TOP_K=1

# Where Milvus writes its bind-mounted data, per the official compose file.
DOCKER_VOLUME_DIRECTORY=.
